set -euo pipefail
cd "${LSS_PROJECT_ROOT:?}"
"${LSS_PYTHON:-python}" "${LSS_CODE_ROOT:?}/collect.py" --results-root "${LSS_RESULTS_ROOT:?}" --study "${LSS_STUDY:?}" --code-version "${LSS_CODE_VERSION:?}"
