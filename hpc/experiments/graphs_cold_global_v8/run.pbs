#!/bin/bash
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=12:00:00
set -euo pipefail
: "${LSS_SEED:?}" "${LSS_OUTPUT:?}"
cd /rg/mendels_prj/alexander.z/latent-space-simulators
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
args=(); [ "${LSS_SMOKE:-0}" = 1 ] && args=(--smoke)
/rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python hpc/experiments/graphs_cold_global_v8/run.py --seed "$LSS_SEED" --output "$LSS_OUTPUT" "${args[@]}"
