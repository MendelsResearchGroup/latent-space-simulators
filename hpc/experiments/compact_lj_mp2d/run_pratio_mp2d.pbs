set -euo pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 MPLCONFIGDIR=/tmp/mpl-${PBS_JOBID}
cd "${PBS_O_WORKDIR:?}"
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python "$LSS_EVAL_RUNNER" --checkpoint "$CHECKPOINT" --recipe "$RECIPE" --out "$OUT"
