#!/usr/bin/env bash
#PBS -N mini100_prep
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l place=free:shared
#PBS -l walltime=06:00:00
#PBS -j oe
set -euo pipefail
cd /rg/mendels_prj/alexander.z/latent-space-simulators
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
mkdir -p notebooks/results/mini_100/logs
exec >"notebooks/results/mini_100/logs/${PBS_JOBID}.log" 2>&1
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u "${LSS_PREP_CODE:?}/prepare.py"
