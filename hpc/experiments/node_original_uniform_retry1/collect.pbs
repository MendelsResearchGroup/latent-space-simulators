#!/usr/bin/env bash
#PBS -N mini_node_uniform_r1_eval
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="${LSS_CODE_ROOT}/src:/rg/mendels_prj/alexander.z/MetaForge/src"
export MPLCONFIGDIR="/tmp/mini-node-uniform-r1-eval-${PBS_JOBID}"
mkdir -p notebooks/results/mini_shared/logs/node_original_uniform_retry1
exec >"notebooks/results/mini_shared/logs/node_original_uniform_retry1/${PBS_JOBID}.log" 2>&1
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u "${LSS_CODE_ROOT}/collect.py" --arm "$LSS_ARM"
