#!/usr/bin/env bash
#PBS -N mini_t1000_uniform_eval
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="${LSS_CODE_ROOT}/src:/rg/mendels_prj/alexander.z/MetaForge/src"
export MPLCONFIGDIR="/tmp/mini-t1000-uniform-eval-${PBS_JOBID}"
mkdir -p notebooks/results/all4_coverage_1000/logs
exec >"notebooks/results/all4_coverage_1000/logs/${PBS_JOBID}.log" 2>&1
PYTHON=/rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python
"$PYTHON" -u "${LSS_CODE_ROOT}/collect.py" --arm "$LSS_ARM" --tag "$LSS_TAG"
exec "$PYTHON" -u "${LSS_CODE_ROOT}/linear_run.py" --arm "$LSS_ARM" --tag "$LSS_TAG"
