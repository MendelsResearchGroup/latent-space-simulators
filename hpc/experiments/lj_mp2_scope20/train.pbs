#!/bin/bash
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail
cd /rg/mendels_prj/alexander.z/latent-space-simulators
export LSS_PROJECT_ROOT="$PWD"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
mkdir -p notebooks/results/lj_mp2_scope20/logs
exec >"notebooks/results/lj_mp2_scope20/logs/${PBS_JOBID}.log" 2>&1
args=(--scope "${LSS_SCOPE:?}" --seed "${LSS_SEED:?}")
if [[ "${LSS_SMOKE:-0}" == "1" ]]; then args+=(--smoke); fi
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u "${LSS_CODE_ROOT:?}/train.py" "${args[@]}"
