#!/usr/bin/env bash
#PBS -N dense_reid
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 NUMEXPR_NUM_THREADS=8
export PYTHONPATH="${LSS_CODE_ROOT}/src:/rg/mendels_prj/alexander.z/MetaForge/src"
export MPLBACKEND=Agg PYTHONDONTWRITEBYTECODE=1
export MPLCONFIGDIR="/tmp/dense-reid-${PBS_JOBID}"
mkdir -p notebooks/results/dense_reid/logs
exec >"notebooks/results/dense_reid/logs/${PBS_JOBID}.log" 2>&1
args=(--dimension "${LSS_DIMENSION}" --seed "${LSS_SEED}")
if [[ "$LSS_SMOKE" == 1 ]]; then args+=(--smoke); fi
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u "${LSS_CODE_ROOT}/run.py" "${args[@]}"
