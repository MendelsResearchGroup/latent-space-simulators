#!/usr/bin/env bash
#PBS -N all4more32ae
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="${LSS_PROJECT_ROOT}/src:/rg/mendels_prj/alexander.z/MetaForge/src"
export MPLCONFIGDIR="/tmp/all4-more-networks-${PBS_JOBID}"
mkdir -p notebooks/results/all4_more_networks_pilot/logs
exec >"notebooks/results/all4_more_networks_pilot/logs/${PBS_JOBID}.log" 2>&1
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u hpc/experiments/all4_more_networks_pilot/train_and_evaluate.py
