#!/usr/bin/env bash
#PBS -N ljsparseinf
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"; export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
mkdir -p notebooks/results/lj_sparse_influence/logs; exec >"notebooks/results/lj_sparse_influence/logs/${PBS_JOBID}.log" 2>&1
PY=/rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python
CODE="${LSS_SPARSE_CODE_ROOT:?}"
"$PY" -u "$CODE/run.py" --arm "${LSS_ARM:?}" --seed 123
exec "$PY" -u "$CODE/postfit_arm.py" --arm "${LSS_ARM:?}" --seed 123
