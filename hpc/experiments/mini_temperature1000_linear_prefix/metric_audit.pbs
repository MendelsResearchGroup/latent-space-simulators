#!/usr/bin/env bash
#PBS -N mt1000_metric
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail

export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="${LSS_PROJECT_ROOT}/hpc/experiments/mini_temperature1000_linear_prefix:${LSS_PROJECT_ROOT}/notebooks/results/all4_coverage_1000/code_v5:${LSS_PROJECT_ROOT}/src:/rg/mendels_prj/alexander.z/MetaForge/src"
export MPLCONFIGDIR="/tmp/mt1000-metric-${PBS_JOBID}"
mkdir -p notebooks/results/all4_coverage_1000/logs
exec >"notebooks/results/all4_coverage_1000/logs/${PBS_JOBID}.log" 2>&1
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u tools/analysis/audit_mixed_rollout_horizon_metric.py
