"${PYTHON}" tools/analysis/execute_notebook.py notebooks/dynamics/200_md_step/02_twenty_trajectories_and_rollout.ipynb
"${PYTHON}" tools/analysis/execute_notebook.py notebooks/dynamics/200_md_step/03_latent_morph_and_attribution.ipynb
