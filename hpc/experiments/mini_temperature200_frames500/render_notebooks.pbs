set -euo pipefail

PROJECT=/rg/mendels_prj/alexander.z/latent-space-simulators
PYTHON=/home/alexander.z/miniconda3/bin/python
export MPLCONFIGDIR="${TMPDIR}/matplotlib"
mkdir -p "${MPLCONFIGDIR}"
cd "${PROJECT}"

"${PYTHON}" tools/analysis/execute_notebook.py notebooks/dynamics/02_mixed_dataset_shared_latent_rollout.ipynb
