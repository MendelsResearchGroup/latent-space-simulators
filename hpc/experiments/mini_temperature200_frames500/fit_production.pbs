#!/usr/bin/env bash
#PBS -N mt200_f500_prod
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="${LSS_CODE_ROOT}:${LSS_CODE_ROOT}/src:/rg/mendels_prj/alexander.z/MetaForge/src"
export MPLCONFIGDIR="/tmp/mt200-f500-prod-${PBS_JOBID}"
RESULT_DIR="${LSS_RESULT_DIR:-notebooks/results/mini_temperature200_frames500}"
mkdir -p "${RESULT_DIR}/logs"
exec >"${RESULT_DIR}/logs/${PBS_JOBID}.log" 2>&1
PYTHON=/rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python
"$PYTHON" -u "${LSS_CODE_ROOT}/train.py" --assert-config
exec "$PYTHON" -u "${LSS_CODE_ROOT}/train.py" --arm "$LSS_ARM" --seed "${LSS_SEED:-123}" --tag "${LSS_TAG:-}"
