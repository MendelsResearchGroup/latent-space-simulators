#!/usr/bin/env bash
#PBS -N mt200_f500_morph
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="${LSS_CODE_ROOT}:${LSS_CODE_ROOT}/src:/rg/mendels_prj/alexander.z/MetaForge/src"
export MPLCONFIGDIR="/tmp/mt200-f500-morph-${PBS_JOBID}"
mkdir -p notebooks/results/mini_temperature200_frames500/logs
exec >"notebooks/results/mini_temperature200_frames500/logs/${PBS_JOBID}.log" 2>&1
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u "${LSS_CODE_ROOT}/morph.py" --count "$LSS_COUNT" --seed "$LSS_SEED" ${LSS_REUSE_FLAG:-}
