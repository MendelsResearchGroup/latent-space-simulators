#!/usr/bin/env bash
#PBS -N mt200_f500_data
#PBS -q mendels_q
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$LSS_PROJECT_ROOT/src:/rg/mendels_prj/alexander.z/MetaForge/src"
mkdir -p notebooks/results/mini_temperature200_frames500/logs
exec >"notebooks/results/mini_temperature200_frames500/logs/${PBS_JOBID}.log" 2>&1
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u hpc/experiments/mini_temperature200_frames500/prepare.py
