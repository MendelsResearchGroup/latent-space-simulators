#!/usr/bin/env bash
#PBS -N mini_node
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 NUMEXPR_NUM_THREADS=8
export PYTHONPATH="${LSS_CODE_ROOT}/src:/rg/mendels_prj/alexander.z/MetaForge/src"
export MPLBACKEND=Agg PYTHONDONTWRITEBYTECODE=1
export MPLCONFIGDIR="/tmp/dense-reid-${PBS_JOBID}"
mkdir -p notebooks/results/mini_node/logs
exec >"notebooks/results/mini_node/logs/${PBS_JOBID}.log" 2>&1
PYTHON=/rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python
"$PYTHON" -u "${LSS_CODE_ROOT}/prepare.py"
"$PYTHON" -u "${LSS_CODE_ROOT}/run.py" --dimension 2 --seed 123 --smoke
"$PYTHON" "${LSS_CODE_ROOT}/check_smoke.py"
exec "$PYTHON" -u "${LSS_CODE_ROOT}/run.py" --dimension 2 --seed 123
