#!/usr/bin/env bash
#PBS -N initial_z_origin
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$LSS_PROJECT_ROOT/notebooks/results/all4_coverage_1000/code_v5/src:/rg/mendels_prj/alexander.z/MetaForge/src"
cd "$LSS_PROJECT_ROOT"
mkdir -p notebooks/results/initial_latent_origin/logs
exec >"notebooks/results/initial_latent_origin/logs/${PBS_JOBID}.log" 2>&1
/rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u hpc/experiments/initial_latent_origin/run.py
