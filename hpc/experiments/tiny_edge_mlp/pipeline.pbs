#!/usr/bin/env bash
#PBS -N tinyedgemlp
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
export LSS_PROJECT_ROOT=/rg/mendels_prj/alexander.z/latent-space-simulators
cd "$LSS_PROJECT_ROOT"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$LSS_PROJECT_ROOT/notebooks/results/all4_coverage_1000/code_v5/src:$LSS_PROJECT_ROOT/src:/rg/mendels_prj/alexander.z/MetaForge/src"
export LSS_TINY_MODEL_PATH="$LSS_CODE_ROOT/tiny_edge_ae.py"
export MPLCONFIGDIR="/tmp/tiny-edge-mlp-${PBS_JOBID}"
mkdir -p notebooks/results/tiny_edge_mlp/logs
exec >"notebooks/results/tiny_edge_mlp/logs/${PBS_JOBID}.log" 2>&1
exec /rg/mendels_prj/alexander.z/DL-course-project/.venv/bin/python -u "$LSS_CODE_ROOT/run.py" --seed "$LSS_SEED"
